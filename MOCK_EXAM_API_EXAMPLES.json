  "notes": {
    "authentication": "Tüm endpoint'ler JWT authentication gerektirir. Authorization header'ında Bearer token gönderilmelidir.",
    "netCalculation": "Net hesaplama: net = doğru - (yanlış / incorrectToNullify). incorrectToNullify değeri exams tablosundan alınır (genellikle 3 veya 4).",
    "recordCheck": "Yeni deneme kaydedilirken aynı sınav tipindeki en yüksek net ile karşılaştırılır. Eğer yeni net daha yüksekse isRecord = true olur.",
    "dateFormat": "examDate formatı: YYYY-MM-DD (ISO date string)",
    "errorResponses": "Hata durumlarında success: false ve message alanı döner. HTTP status code'lar: 400 (Bad Request), 401 (Unauthorized), 404 (Not Found), 500 (Internal Server Error)"
  }
